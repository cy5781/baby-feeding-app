<view class="container">
  <view class="section-title">宝宝有什么不舒服？</view>

  <!-- 4 large illness cards in 2x2 grid -->
  <view class="illness-grid">
    <button
      wx:for="{{cards}}"
      wx:key="key"
      class="{{item.cardClass}}"
      data-key="{{item.key}}"
      bindtap="pickIllness"
    >
      <text class="illness-card-icon">{{item.icon}}</text>
      <text class="illness-card-label">{{item.label}}</text>
    </button>
  </view>

  <!-- Other symptom input (shown when "其他症状" selected) -->
  <view wx:if="{{illnessType === 'other'}}" style="margin-top: 24rpx;">
    <input
      class="illness-other-input"
      placeholder="请输入具体症状，如：起红疹…"
      value="{{otherText}}"
      bindinput="onOtherText"
      maxlength="50"
    />
  </view>

  <!-- Date/time -->
  <view class="section-title" style="margin-top: 32rpx;">记录时间</view>
  <view class="chip-row" style="margin-bottom: 16rpx;">
    <text
      wx:for="{{dateOffsets}}"
      wx:key="value"
      class="{{item.chipClass}}"
      data-offset="{{item.value}}"
      bindtap="pickDateOffset"
    >{{item.label}}</text>
  </view>
  <picker mode="time" value="{{customTime}}" bindchange="onTimeChange">
    <view class="time-picker-btn">{{customTime}}</view>
  </picker>

  <!-- Note -->
  <view class="section-title" style="margin-top: 28rpx;">备注（选填）</view>
  <textarea
    class="note-textarea"
    placeholder="例如：体温38.5度、吃了退烧药…"
    value="{{note}}"
    bindinput="onNote"
    auto-height
    maxlength="200"
  />

  <button class="btn btn-primary" style="width:100%; margin-top: 48rpx;" bindtap="save">✅ 记录完成</button>
</view>
