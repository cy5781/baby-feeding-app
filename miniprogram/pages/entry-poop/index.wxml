<view class="container">
  <view class="section-title">类型</view>
  <view class="chip-row" style="margin-bottom: 28rpx;">
    <text
      wx:for="{{types}}"
      wx:key="value"
      class="{{item.chipClass}}"
      data-val="{{item.value}}"
      bindtap="pickType"
    >{{item.value}}</text>
  </view>

  <view class="section-title">颜色</view>
  <view class="chip-row" style="margin-bottom: 28rpx;">
    <text
      wx:for="{{colors}}"
      wx:key="value"
      class="{{item.chipClass}}"
      data-val="{{item.value}}"
      bindtap="pickColor"
    >{{item.value}}</text>
  </view>

  <view class="section-title">排便量</view>
  <view class="chip-row" style="margin-bottom: 36rpx;">
    <text
      wx:for="{{amounts}}"
      wx:key="value"
      class="{{item.chipClass}}"
      data-val="{{item.value}}"
      bindtap="pickAmount"
    >{{item.value}}</text>
  </view>

  <view class="section-title">记录时间</view>
  <view class="chip-row" style="margin-bottom: 16rpx;">
    <text
      wx:for="{{dateOffsets}}"
      wx:key="value"
      class="{{item.chipClass}}"
      data-offset="{{item.value}}"
      bindtap="pickDateOffset"
    >{{item.label}}</text>
  </view>
  <picker mode="time" value="{{customTime}}" bindchange="onTimeChange">
    <view class="time-picker-btn">{{customTime}}</view>
  </picker>

  <view class="section-title" style="margin-top: 28rpx;">备注（选填）</view>
  <textarea
    class="note-textarea"
    placeholder="例如：有点稀"
    value="{{note}}"
    bindinput="onNote"
    auto-height
    maxlength="200"
  />

  <button class="btn btn-primary" style="width:100%; margin-top: 48rpx;" bindtap="save">保存记录</button>
</view>