<view class="container">
  <view class="section-title">宝宝在做什么？</view>

  <!-- 2 large sleep cards -->
  <view style="display:flex; gap: 20rpx; margin-bottom: 36rpx;">
    <button
      wx:for="{{cards}}"
      wx:key="key"
      class="{{item.cardClass}}"
      style="flex:1;"
      data-key="{{item.key}}"
      bindtap="pick"
    >
      <text class="sleep-card-label">{{item.label}}</text>
    </button>
  </view>

  <view class="section-title">记录时间</view>
  <view class="chip-row" style="margin-bottom: 16rpx;">
    <text
      wx:for="{{dateOffsets}}"
      wx:key="value"
      class="{{item.chipClass}}"
      data-offset="{{item.value}}"
      bindtap="pickDateOffset"
    >{{item.label}}</text>
  </view>
  <picker mode="time" value="{{customTime}}" bindchange="onTimeChange">
    <view class="time-picker-btn">{{customTime}}</view>
  </picker>

  <view class="section-title" style="margin-top: 28rpx;">备注（选填）</view>
  <textarea
    class="note-textarea"
    placeholder="例如：睡得很香"
    value="{{note}}"
    bindinput="onNote"
    auto-height
    maxlength="200"
  />

  <button class="btn btn-primary" style="width:100%; margin-top: 48rpx;" bindtap="save">保存记录</button>
</view>
