.container {
  padding: 16rpx 24rpx 32rpx;
}

.pi-photo-card {
  margin-bottom: 24rpx;
}

.pi-capture {
  text-align: center;
  padding: 36rpx 16rpx;
  border: 3rpx dashed #D3E6CB;
  border-radius: 28rpx;
  background: #F9FCF7;
}

.pi-capture-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.pi-capture-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #33422E;
  margin-bottom: 10rpx;
}

.pi-capture-hint {
  font-size: 28rpx;
  color: #7E9078;
  margin-bottom: 28rpx;
}

.pi-capture-btn {
  width: 100%;
}

.pi-preview {
  width: 100%;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
}

.pi-stage {
  font-size: 28rpx;
  color: #4F9668;
  text-align: center;
  padding: 8rpx 0 20rpx;
  font-weight: 700;
}

.pi-photo-actions {
  display: flex;
  gap: 16rpx;
}

.pi-btn-secondary {
  flex: 1;
  min-height: 88rpx;
  background: #ffffff;
  border: 2rpx solid #4F9668;
  color: #2C6B40;
  padding: 26rpx 16rpx;
  font-size: 30rpx;
}

.pi-result-head {
  padding: 8rpx 8rpx 16rpx;
}

.pi-result-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #33422E;
}

.pi-result-hint {
  font-size: 28rpx;
  color: #7E9078;
  margin-top: 6rpx;
}

.pi-date-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
  padding: 24rpx 28rpx;
}

.pi-date-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #33422E;
}

.pi-date-picker {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.pi-date-value {
  font-size: 30rpx;
  color: #4F9668;
  font-weight: 800;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #DCEFDA;
}

.pi-date-hint {
  width: 100%;
  font-size: 28rpx;
  color: #7E9078;
  margin-top: 10rpx;
}

.pi-list {
  margin-bottom: 8rpx;
}

.pi-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 6rpx 18rpx rgba(51, 66, 46, 0.08);
}

.pi-item-off {
  opacity: 0.55;
}

.pi-check-hit {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: -16rpx 0 -16rpx -8rpx;
}

.pi-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid #D3E6CB;
  background: #ffffff;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.pi-check-on {
  background: #4F9668;
  border-color: #4F9668;
}

.pi-item-body {
  flex: 1;
  min-width: 0;
}

.pi-item-desc {
  font-size: 32rpx;
  font-weight: 800;
  color: #33422E;
  line-height: 1.4;
}

.pi-item-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.pi-item-date {
  font-size: 28rpx;
  color: #7E9078;
}

.pi-time-picker {
  min-height: 88rpx;
  display: flex;
  align-items: center;
}

.pi-time {
  font-size: 28rpx;
  font-weight: 700;
  color: #4F9668;
  padding: 6rpx 14rpx;
  background: #DCEFDA;
  border-radius: 10rpx;
}

.pi-time-warn {
  color: #8A5A16;
  background: #FBEBD2;
}

.pi-raw {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 20rpx 24rpx;
  margin: 12rpx 0 24rpx;
}

.pi-raw-toggle {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #7E9078;
  font-weight: 700;
  text-align: center;
}

.pi-raw-text {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #33422E;
  white-space: pre-wrap;
  word-break: break-all;
  background: #F5FAF3;
  border-radius: 16rpx;
  padding: 16rpx;
  max-height: 480rpx;
  overflow-y: auto;
}

.pi-save-btn {
  width: 100%;
  margin-top: 12rpx;
}

.pi-error-card {
  text-align: center;
  padding: 36rpx 28rpx;
}

.pi-error-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.pi-error-text {
  font-size: 30rpx;
  color: #7E9078;
  line-height: 1.6;
}

.pi-bottom-space {
  height: 40rpx;
}
