<view class="container">
  <!-- Weight card -->
  <view class="card weight-card" style="margin-bottom: 28rpx;" bindtap="showWeight">
    <view style="display:flex; align-items:center; gap: 20rpx;">
      <view class="weight-card-icon">⚖️</view>
      <view style="flex:1;">
        <view class="weight-card-label">📏 添加今日体重</view>
        <view class="weight-card-value" wx:if="{{latestWeight}}">最近：{{latestWeight.weightKg}}kg（{{latestWeight.dateKey}}）</view>
        <view class="weight-card-value" wx:else>点击记录宝宝体重</view>
      </view>
      <view style="font-size:36rpx; color:#7E9078;">›</view>
    </view>
  </view>

  <!-- Weight input overlay -->
  <view class="{{weightOverlayClass}}">
    <view class="weight-backdrop" bindtap="hideWeight"></view>
    <view class="weight-sheet">
      <view class="med-sheet-title">记录体重</view>
      <view style="display:flex; align-items:center; justify-content:center; gap: 8rpx; margin-bottom: 24rpx;">
        <input class="weight-input" type="digit" placeholder="0.0" value="{{weightKg}}" bindinput="onWeightInput" />
        <text style="font-size:36rpx; font-weight:700; color:#33422E;">kg</text>
      </view>
      <view style="margin-bottom: 24rpx;">
        <picker mode="time" value="{{weightTime}}" bindchange="onWeightTimeChange">
          <view class="time-picker-btn">{{weightTime}}</view>
        </picker>
      </view>
      <view style="display:flex; gap: 16rpx;">
        <button class="btn" style="flex:1;" bindtap="hideWeight">取消</button>
        <button class="btn btn-primary" style="flex:1;" bindtap="saveWeight">保存</button>
      </view>
    </view>
  </view>

  <!-- Today card -->
  <view class="card" style="margin-bottom: 28rpx;">
    <view style="font-size: 28rpx; font-weight: 700; color: #7E9078; margin-bottom: 16rpx;">今日</view>
    <view class="chip-row">
      <view class="chip">🍼 喝奶 {{today.milkCount || 0}}次 · {{today.milkTotal || 0}}ml</view>
      <view class="chip">🥣 辅食 {{today.solidCount || 0}}次</view>
      <view class="chip">💩 便便 {{today.poopCount || 0}}次</view>
    </view>
  </view>

  <!-- Weight growth chart -->
  <view class="card" style="margin-bottom: 28rpx;" wx:if="{{weightData.length > 0}}">
    <view style="font-size: 28rpx; font-weight: 700; color: #7E9078; margin-bottom: 16rpx;">📈 体重变化</view>
    <scroll-view scroll-x="{{true}}" style="white-space:nowrap;">
      <view style="display:inline-flex; gap: 20rpx;">
        <view
          wx:for="{{weightData}}"
          wx:key="dateKey"
          style="text-align:center; min-width:140rpx; padding:16rpx; background:#F5FAF3; border-radius:16rpx;"
        >
          <view style="font-size:22rpx; color:#7E9078;">{{item.dateKey}}</view>
          <view style="font-size:36rpx; font-weight:800; color:#4F9668;">{{item.weightKg}}kg</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Range toggle -->
  <view style="display:flex; gap: 16rpx; margin-bottom: 24rpx;">
    <button class="{{days7Class}}" style="flex:1" data-days="7" bindtap="setDays">近7天</button>
    <button class="{{days30Class}}" style="flex:1" data-days="30" bindtap="setDays">近30天</button>
  </view>

  <!-- Daily rows -->
  <view class="list" wx:if="{{rows.length > 0}}">
    <view
      wx:for="{{rows}}"
      wx:key="dateKey"
      class="item"
      wx:if="{{item.milkCount > 0 || item.solidCount > 0 || item.poopCount > 0 || item.weightKg > 0}}"
    >
      <view class="item-title">{{item.dateKey}}</view>
      <view class="item-meta">
        🍼 {{item.milkCount}}次 · {{item.milkTotal}}ml
        <text wx:if="{{item.solidCount > 0}}"> | 🥣 {{item.solidCount}}次</text>
        <text wx:if="{{item.poopCount > 0}}"> | 💩 {{item.poopCount}}次</text>
        <text wx:if="{{item.weightKg > 0}}"> | ⚖️ {{item.weightKg}}kg</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>暂无数据</view>

  <!-- Vaccine calendar -->
  <view class="section-title" style="margin-top: 40rpx;">💉 疫苗日历</view>
  <view class="vaccine-list" wx:if="{{vaccines.length > 0}}">
    <view wx:for="{{vaccines}}" wx:key="name" class="vaccine-row">
      <text class="vaccine-status">{{item.status === 'done' ? '✅' : '⏳'}}</text>
      <view style="flex:1;">
        <text style="font-size:26rpx; font-weight:700; color:#33422E;">{{item.name}}</text>
        <text style="font-size:22rpx; color:#7E9078; margin-left:12rpx;">{{item.desc}}</text>
      </view>
    </view>
  </view>
  <view class="empty" wx:else style="padding-top:16rpx;">记录疫苗后显示接种日历</view>
</view>
