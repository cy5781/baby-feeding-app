<view class="container">
  <view class="section-title">奶量（ml）</view>
  <view class="chip-row" style="margin-bottom: 28rpx;">
    <text
      wx:for="{{quick}}"
      wx:key="value"
      class="{{item.chipClass}}"
      data-val="{{item.value}}"
      bindtap="pick"
    >{{item.value}}ml</text>
  </view>

  <view style="display:flex; align-items:center; gap: 20rpx; margin-bottom: 36rpx;">
    <button class="btn" style="width:100rpx; font-size:40rpx; padding:20rpx;" data-delta="-10" bindtap="step">−</button>
    <view style="flex:1; text-align:center;">
      <input
        type="number"
        style="font-size: 56rpx; font-weight: 800; text-align: center; width: 100%; color: #E3A857;"
        value="{{amount}}"
        bindinput="onAmount"
      />
      <view style="font-size:24rpx; color:#7E9078;">毫升</view>
    </view>
    <button class="btn" style="width:100rpx; font-size:40rpx; padding:20rpx;" data-delta="10" bindtap="step">+</button>
  </view>

  <view class="section-title">喂养方式</view>
  <view class="chip-row" style="margin-bottom: 28rpx;">
    <text
      wx:for="{{methods}}"
      wx:key="key"
      class="{{item.chipClass}}"
      data-key="{{item.key}}"
      bindtap="pickMethod"
    >{{item.label}}</text>
  </view>

  <view class="section-title">记录时间</view>
  <view class="chip-row" style="margin-bottom: 16rpx;">
    <text
      wx:for="{{dateOffsets}}"
      wx:key="value"
      class="{{item.chipClass}}"
      data-offset="{{item.value}}"
      bindtap="pickDateOffset"
    >{{item.label}}</text>
  </view>
  <picker mode="time" value="{{customTime}}" bindchange="onTimeChange">
    <view class="time-picker-btn">{{customTime}}</view>
  </picker>

  <view class="section-title" style="margin-top: 28rpx;">备注（选填）</view>
  <textarea
    class="note-textarea"
    placeholder="例如：加了D3"
    value="{{note}}"
    bindinput="onNote"
    auto-height
    maxlength="200"
  />

  <button class="btn btn-primary" style="width:100%; margin-top: 48rpx;" bindtap="save">保存记录</button>
</view>