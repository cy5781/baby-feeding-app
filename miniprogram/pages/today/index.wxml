<view class="container">

  <!-- Brand title -->
  <view class="brand-title">宝宝喂养记录</view>
  <view class="date-bar">
    <text>{{monthDay}} {{weekday}}</text>
    <text class="dot-sep">·</text>
    <text>天气 {{weather}}</text>
  </view>

  <!-- Last feed card -->
  <view class="last-feed-card" wx:if="{{lastMilk}}">
    <view class="last-feed-icon">🍼</view>
    <view style="flex:1;">
      <view class="last-feed-label">距上次喂奶</view>
      <view class="last-feed-value">{{lastMilk.ago}} · {{lastMilk.time}}</view>
      <view class="last-feed-progress">
        <view class="last-feed-progress-bar" style="width: {{lastMilk.progress}}%;"></view>
      </view>
    </view>
  </view>

  <!-- Quick entry grid -->
  <view class="section-title">一键记录</view>
  <view class="quick-grid">
    <button class="quick-btn quick-feed" bindtap="goMilk">
      <text class="quick-icon">🍼</text>
      <text class="quick-label">喂奶</text>
    </button>
    <button class="quick-btn quick-poop" bindtap="goPoop">
      <text class="quick-icon">💩</text>
      <text class="quick-label">便便</text>
    </button>
    <button class="quick-btn quick-solid" bindtap="goSolid">
      <text class="quick-icon">🥣</text>
      <text class="quick-label">辅食</text>
    </button>
    <button class="quick-btn quick-med" bindtap="goMed">
      <text class="quick-icon">💊</text>
      <text class="quick-label">用药</text>
    </button>
  </view>

  <!-- Today summary -->
  <view class="card" style="margin-bottom: 32rpx;">
    <view style="font-size: 28rpx; font-weight: 700; color: #7E9078; margin-bottom: 16rpx;">今日汇总</view>
    <view class="summary-grid">
      <view class="summary-chip">🍼 喝奶 {{summaryMilkCount}}次 · {{summaryMilkTotal}}ml</view>
      <view class="summary-chip">🥣 辅食 {{summarySolidCount}}次</view>
      <view class="summary-chip">💩 便便 {{summaryPoopCount}}次</view>
      <view class="summary-chip">💊 用药 {{medCount}}次{{medSummary}}</view>
    </view>
  </view>

  <!-- Today timeline -->
  <view class="section-title">今日记录</view>

  <!-- Time filter -->
  <scroll-view scroll-x="{{true}}" class="filter-scroll">
    <text
      wx:for="{{filters}}"
      wx:key="key"
      class="{{item.activeClass}}"
      data-key="{{item.key}}"
      bindtap="onFilter"
    >{{item.label}}</text>
    <text class="{{customClass}}" bindtap="onCustomRange">{{customLabel}}</text>
  </scroll-view>

  <!-- Timeline list -->
  <view class="timeline" wx:if="{{filteredItems.length > 0}}">
    <view
      wx:for="{{filteredItems}}"
      wx:key="_id"
      class="t-item {{item.type}}"
    >
      <view>
        <text class="t-time">{{item.time}}</text>
        <text class="t-main">{{item.desc}}</text>
      </view>
      <button class="t-more" data-id="{{item._id}}" bindtap="onDeleteItem">···</button>
    </view>
  </view>

  <!-- Empty state -->
  <view class="empty" wx:else>这段时间还没有记录</view>

  <view class="page-bottom"></view>
</view>

<!-- Floating mic button -->
<view class="mic-dock">
  <button class="mic-btn" bindtap="goVoice">
    <view class="mic-dot"></view>
    🎤 说一句话记录
  </button>
</view>

<!-- Custom range overlay -->
<view class="{{rangeOverlayClass}}" bindtap="closeRange">
  <view class="sheet" catchtap="">
    <view style="font-size: 34rpx; font-weight: 700; margin-bottom: 12rpx;">自定义时间段</view>
    <view style="font-size: 26rpx; color: #7E9078; margin-bottom: 24rpx;">选择开始和结束时间</view>
    <view style="display:flex; gap: 20rpx; margin-bottom: 28rpx;">
      <view style="flex:1;">
        <view style="font-size:24rpx; color:#7E9078; margin-bottom:8rpx;">开始</view>
        <picker mode="time" value="{{rangeStart}}" bindchange="onRangeStart">
          <view class="time-input">{{rangeStart || '00:00'}}</view>
        </picker>
      </view>
      <view style="flex:1;">
        <view style="font-size:24rpx; color:#7E9078; margin-bottom:8rpx;">结束</view>
        <picker mode="time" value="{{rangeEnd}}" bindchange="onRangeEnd">
          <view class="time-input">{{rangeEnd || '23:59'}}</view>
        </picker>
      </view>
    </view>
    <button class="btn btn-primary" style="width:100%; margin-bottom: 12rpx;" bindtap="applyCustomRange">查看这段时间</button>
    <button class="btn" style="width:100%; color:#7E9078;" bindtap="closeRange">取消</button>
  </view>
</view>
