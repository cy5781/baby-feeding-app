/* Last-feed card */
.last-feed-card {
  background: #4F9668;
  color: #fff;
  border-radius: 28rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 6px 18px rgba(51,66,46,0.15);
  margin-bottom: 32rpx;
}
.last-feed-card-warn {
  background: #E38A72;
  box-shadow: 0 6px 18px rgba(227,138,114,0.25);
}
.last-feed-card-hint {
  background: #E3A857;
  box-shadow: 0 6px 18px rgba(227,168,87,0.25);
}
.last-feed-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}
.last-feed-label {
  font-size: 24rpx;
  opacity: 0.85;
}
.last-feed-value {
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 4rpx;
}
.last-feed-progress {
  margin-top: 12rpx;
  height: 8rpx;
  width: 100%;
  background: rgba(255,255,255,0.2);
  border-radius: 4rpx;
  overflow: hidden;
}
.last-feed-progress-bar {
  height: 100%;
  background: #E3A857;
  border-radius: 4rpx;
  transition: width 0.6s ease;
}

/* Quick action grid */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.quick-btn {
  width: 100%;
  border: none;
  border-radius: 28rpx;
  padding: 28rpx 12rpx;
  text-align: center;
  box-shadow: 0 4px 16px rgba(51,66,46,0.08);
  line-height: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.quick-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.quick-icon {
  font-size: 40rpx;
  display: block;
}

.quick-label {
  font-size: 26rpx;
  font-weight: 700;
  display: block;
}

.quick-feed {
  background: #FBEBD2;
  color: #8A5A16;
}
.quick-poop {
  background: #EDE4D6;
  color: #6B4A28;
}
.quick-solid {
  background: #EDE4D6;
  color: #6B4A28;
}
.quick-med {
  background: #DCEEE9;
  color: #2C6B5C;
}
.quick-sleep {
  background: #DCEFDA;
  color: #2C6B40;
}
.quick-weight {
  background: #EDE4D6;
  color: #6B4A28;
}

/* Timeline */
.timeline {
  position: relative;
  padding-left: 28rpx;
}
.timeline::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 8rpx;
  bottom: 8rpx;
  width: 3rpx;
  background: repeating-linear-gradient(
    #D3E6CB 0rpx, #D3E6CB 12rpx,
    transparent 12rpx, transparent 20rpx
  );
}
.t-item {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
}
.t-item::before {
  content: "";
  position: absolute;
  left: -28rpx;
  top: 22rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  border: 3rpx solid #F5FAF3;
}
.t-item.milk::before { background: #E3A857; }
.t-item.solid::before { background: #A9784A; }
.t-item.poop::before { background: #A9784A; }
.t-item.med::before { background: #3F8F7A; }
.t-item.sleep::before { background: #4F9668; }
.t-item.vaccine::before { background: #E3A857; }
.t-item.illness::before { background: #E38A72; }
.t-item.weight::before { background: #7E9078; }

.t-time {
  font-size: 24rpx;
  color: #7E9078;
  display: block;
  margin-bottom: 4rpx;
}
.t-main {
  font-size: 28rpx;
  color: #33422E;
}
.t-more {
  border: none;
  background: none;
  color: #7E9078;
  font-size: 36rpx;
  padding: 0 8rpx;
  line-height: 1;
}

/* Filter chips scroll */
.filter-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
}
.filter-chip {
  display: inline-block;
  padding: 14rpx 28rpx;
  border-radius: 28rpx;
  border: 2rpx solid #D3E6CB;
  background: #fff;
  font-size: 26rpx;
  color: #7E9078;
  font-weight: 600;
  margin-right: 12rpx;
}
.filter-chip.active {
  background: #4F9668;
  color: #fff;
  border-color: #4F9668;
}

/* Mic dock */
.mic-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(0deg, #F5FAF3 60%, transparent);
  z-index: 10;
}
.mic-btn {
  width: 100%;
  border: none;
  border-radius: 56rpx;
  background: #4F9668;
  color: #fff;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-shadow: 0 8px 28px rgba(79,150,104,0.4);
}
.mic-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E38A72;
  animation: mic-pulse 1.4s infinite;
}
@keyframes mic-pulse {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.6); opacity: 0.4; }
}

/* Extra bottom space for mic dock */
.page-bottom {
  height: 180rpx;
}

/* ===== Onboarding ===== */
.onboarding-overlay {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(30,26,20,0.55);
  display: none;
  align-items: center;
  justify-content: center;
  z-index: 300;
}
.onboarding-overlay.active {
  display: flex;
}

.onboarding-card {
  width: 85%;
  background: #fff;
  border-radius: 32rpx;
  padding: 48rpx 32rpx 36rpx;
  box-shadow: 0 12px 48px rgba(51,66,46,0.2);
}

.onboarding-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #33422E;
  text-align: center;
  margin-bottom: 12rpx;
}

/* Date bar */
.date-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 26rpx;
  color: #7E9078;
  margin-bottom: 20rpx;
}
.date-bar .dot-sep {
  color: #D3E6CB;
}

/* Summary grid — 2x2 even chips */
.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.summary-chip {
  background: #ffffff;
  border: 2rpx solid #D3E6CB;
  border-radius: 20rpx;
  padding: 20rpx 18rpx;
  font-weight: 700;
  color: #33422E;
  font-size: 26rpx;
  text-align: center;
}

/* ===== Med ActionSheet ===== */
.med-sheet-overlay {
  position: fixed;
  top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(30,26,20,0.45);
  display: none;
  align-items: flex-end;
  z-index: 200;
}
.med-sheet-overlay.active {
  display: flex;
}

.med-sheet {
  width: 100%;
  background: #F5FAF3;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.med-sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #33422E;
  text-align: center;
  margin-bottom: 32rpx;
}

.med-sheet-btn {
  width: 100%;
  border: none;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  box-shadow: 0 4px 14px rgba(51,66,46,0.08);
}
.med-sheet-btn:active {
  opacity: 0.85;
  transform: scale(0.97);
}

.med-sheet-icon {
  font-size: 48rpx;
  display: block;
}

.med-sheet-label {
  font-size: 34rpx;
  font-weight: 800;
  display: block;
}

.med-sheet-hint {
  font-size: 24rpx;
  opacity: 0.7;
  display: block;
}

.med-sheet-drug {
  background: #DCEEE9;
  color: #2C6B5C;
}

.med-sheet-vaccine {
  background: #FBEBD2;
  color: #8A5A16;
}

.med-sheet-illness {
  background: #FBE2DA;
  color: #A04030;
}

.med-sheet-cancel {
  width: 100%;
  border: 2rpx solid #D3E6CB;
  border-radius: 24rpx;
  background: #fff;
  color: #7E9078;
  font-size: 30rpx;
  font-weight: 700;
  padding: 28rpx;
  margin-top: 8rpx;
}

